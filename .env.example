# --- Required ---------------------------------------------------------------
# Bot token from @BotFather. Keep it secret: set it on your host, never commit it.
BOT_TOKEN=
# Public HTTPS address where this service is reachable (no trailing slash).
# The mini app is served from here, and the bot's buttons open it.
WEBAPP_URL=
# Telegram user IDs of the owners, comma-separated. Owners can do everything in the bot
# and on the admin site (/admin), and add Managers and Viewers there.
# Get your ID from @userinfobot.
ADMIN_IDS=

# --- Optional ---------------------------------------------------------------
# A Telegram group where the bot posts submissions, orders and creator questions.
# Add the bot to the group, then put the group's ID here (a negative number).
# Without it, the bot writes to each admin in private.
ADMIN_CHAT_ID=
# Invite link to the closed community group for members.
COMMUNITY_CHAT_URL=
# Welcome video: a Telegram file_id, or a public https link to an mp4.
WELCOME_VIDEO=
# Apify API token: reads public Instagram and TikTok data (profiles, posts, stories).
# Without it the app answers with clearly marked demo data, so it still works for a demo.
APIFY_TOKEN=
# Where uploaded and downloaded files live (covers, avatars, story copies).
# Default: a media folder next to the database. Put it on the same persistent disk.
MEDIA_DIR=
# Where the SQLite database file lives. Put it on a persistent disk.
DATABASE_PATH=./data/hub.db
PORT=3000

# --- Local development only -------------------------------------------------
# Lets you open the mini app in a normal browser, without Telegram, as this user.
# Ignored when NODE_ENV=production.
DEV_USER_ID=
